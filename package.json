{
  "name": "loe-outage-schedule",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Unofficial static display of Lvivoblenergo hourly outage schedules, built by GitHub Actions and served from GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:live": "node --test \"live/**/*.test.js\"",
    "update": "node scripts/update.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
